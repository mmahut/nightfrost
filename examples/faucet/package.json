{
  "name": "nightfrost-faucet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build && vite build --config vite.server.config.ts",
    "build:web": "tsc --noEmit && vite build",
    "build:server": "tsc --noEmit -p tsconfig.server.json && vite build --config vite.server.config.ts",
    "test": "npm run build:server && node --test src/server.test.mjs",
    "start": "node server-dist/server.js",
    "test:e2e": "node --experimental-transform-types --test e2e/faucet.e2e.mts"
  },
  "dependencies": {
    "@effect/platform": "^0.96.1",
    "@midnight-ntwrk/ledger-v8": "8.1.1",
    "@midnightntwrk/wallet-sdk": "^1.2.0",
    "@midnightntwrk/wallet-sdk-hd": "3.0.3",
    "@scure/bip39": "2.0.1",
    "buffer": "^6.0.3",
    "effect": "^3.22.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "~5.6.2",
    "vite": "^8.2.1"
  }
}
