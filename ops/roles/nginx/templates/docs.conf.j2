# Generated by Ansible. HTTP only for now; terminate TLS in front of this
# vhost when certificates are ready.
server {
    listen 80;
    listen [::]:80;
    server_name docs.nightfrost.dev;

    root {{ nightfrost_docs_root }};
    index index.html;

    access_log /var/log/nginx/nightfrost-docs.access.log;
    error_log /var/log/nginx/nightfrost-docs.error.log;

    location / {
        try_files $uri $uri/ =404;
    }
}
