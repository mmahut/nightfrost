# Generated by Ansible. HTTP only for now; terminate TLS in front of this
# vhost when certificates are ready.
server {
    listen 80;
    listen [::]:80;
    server_name explorer.nightfrost.dev;

    root {{ nightfrost_explorer_root }};
    index index.html;

    access_log /var/log/nginx/nightfrost-explorer.access.log;
    error_log /var/log/nginx/nightfrost-explorer.error.log;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
