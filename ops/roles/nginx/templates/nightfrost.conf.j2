# Generated by Ansible. HTTP only for now; terminate TLS in front of these
# vhosts when certificates are ready.
#
# One zone shared by all three network vhosts, keyed by client IP and Host
# header together, so each network's quota is enforced independently rather
# than one client draining all three networks' allowance at once.
limit_req_zone $binary_remote_addr$host zone=nightfrost_api:10m rate=20r/s;

{% for indexer in nightfrost_indexers %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ indexer.hostname }};

    access_log /var/log/nginx/nightfrost-{{ indexer.hostname }}.access.log;
    error_log /var/log/nginx/nightfrost-{{ indexer.hostname }}.error.log;

    location / {
        limit_req zone=nightfrost_api burst=500 nodelay;

        proxy_pass http://127.0.0.1:{{ indexer.listen_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
{% endfor %}
